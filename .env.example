# PostgreSQL connection used by the document library.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Private Folio workspace login. Use a password with at least 12 characters.
FOLIO_USERNAME=admin
FOLIO_PASSWORD=replace-with-a-long-unique-password

# Signs the HTTP-only session cookie. Generate one with:
# openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters
